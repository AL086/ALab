# 服务器 192.168.10.11 的生产环境变量模板。
# 部署脚本首次运行会把它放到 /opt/kb/app/.env；之后不会再覆盖。
# 中间件都跑在同一台机器上，所以一律走 127.0.0.1（MinIO SDK 用 9000，9001 是控制台）。
APP_ENV=prod
PORT=8080
PUBLIC_BASE_URL=http://192.168.10.11

DATABASE_URL=postgres://kbuser:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/kb?sslmode=disable

MEILI_HOST=http://127.0.0.1:7700
MEILI_API_KEY=CHANGE_ME_MEILI_MASTER_KEY
MEILI_INDEX=kb_search

S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
S3_BUCKET=kb-files
S3_USE_SSL=false

# 正式环境请换成 32 位随机串；换掉后旧 token 全部失效
JWT_SECRET=change-me-to-32-random-chars

ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
