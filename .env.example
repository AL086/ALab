# 本地开发环境变量示例，复制为 .env 后按实际部署修改
APP_ENV=dev
PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080

# PostgreSQL
DATABASE_URL=postgres://kbuser:CHANGE_ME_DB_PASSWORD@192.168.10.11:5432/kb?sslmode=disable

# Meilisearch
MEILI_HOST=http://192.168.10.11:7700
MEILI_API_KEY=CHANGE_ME_MEILI_MASTER_KEY
MEILI_INDEX=kb_search

# MinIO（SDK 用 9000，9001 是网页控制台）
S3_ENDPOINT=http://192.168.10.11:9000
S3_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
S3_BUCKET=kb-files
S3_USE_SSL=false

# JWT（至少 16 字符，太短会拒绝启动）
JWT_SECRET=dev-only-change-me

# 首次启动时创建的管理员；库里已有用户后这两项不再生效
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
